# Copiá este archivo a .env para desarrollo local contra un Postgres real.
# (Para probar sin Postgres instalado, usá: node dev/dev-server.js)

# Connection string de Postgres. Ejemplos:
#   local:  postgres://postgres:postgres@localhost:5432/lealbets
#   Neon:   postgres://usuario:password@ep-algo.neon.tech/lealbets?sslmode=require
DATABASE_URL=

# Secreto para firmar los tokens de sesión (cualquier string largo y random).
JWT_SECRET=

# Contraseña separada para entrar al panel de administrador.
ADMIN_PASSWORD=

PORT=3000
